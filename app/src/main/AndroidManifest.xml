<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.djicompanion">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <package android:name="com.dji.agflow" />
        <package android:name="com.dji.agrasx" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.documentsui" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="agworkflow" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="T100 伴随助手"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DjiAccessibilityService"
            android:exported="false"
            android:label="T100 伴随助手"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".CommandPollService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
